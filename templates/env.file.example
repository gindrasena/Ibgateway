
APP_NAME=IBKR Signal Gateway
DB_URL=sqlite:///./data/app.db

# 1 = use mock OHLC data (default)
USE_MOCK_DATA=1

# Comma-separated US stock symbols (max 20) used for dropdown/watchlist AND dashboard/API filter
SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,QCOM,ARM,P,META,MU

# Signal toggles: set 0 to disable emitting those signals
ALLOW_BUY=1
ALLOW_SELL=1

# IBKR (read-only) - optional for future extension
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=12
